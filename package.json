{
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --recursive --parallel --if-present run dev",
    "build": "pnpm --recursive --if-present run build",
    "generate:bindings": "rimraf packages/kit/src/bindings && cargo test export_bindings --workspace && biome format --fix 'packages/kit/src/bindings/'"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@types/node": ">=24",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "rimraf": "^6.1.2",
    "typescript": "^5.5.4"
  },
  "pnpm": {
    "overrides": {
      "globals": "14.0.0"
    }
  },
  "packageManager": "pnpm@10.34.5"
}
